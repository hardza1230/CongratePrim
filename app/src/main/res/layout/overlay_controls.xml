<?xml version="1.0" encoding="utf-8"?>
<!-- The floating control panel drawn by the AccessibilityService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AutoTapper ⠿"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="6dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/panel_start" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/panel_stop" />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/panel_capture" />

    <Button
        android:id="@+id/btnImgCond"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/panel_img_cond" />

    <Button
        android:id="@+id/btnHide"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/panel_hide" />
</LinearLayout>
